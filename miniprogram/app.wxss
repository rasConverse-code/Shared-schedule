page {
  background: #f4f6fa;
  color: #1c1f26;
  font-size: 28rpx;
  line-height: 1.5;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', 'PingFang SC',
    'Microsoft YaHei', sans-serif;
  box-sizing: border-box;
}

view,
text,
button,
input,
textarea,
picker {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  background: transparent;
  border-radius: 0;
  line-height: inherit;
  font-size: inherit;
}

button::after {
  border: none;
}

.safe-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}

.btn-primary {
  background: #4f6ef7;
  color: #fff;
  border-radius: 16rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 500;
}

.btn-primary.disabled {
  opacity: 0.45;
}

.btn-ghost {
  background: #eef1fe;
  color: #4f6ef7;
  border-radius: 16rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 500;
}

.empty-tip {
  color: #8b93a7;
  font-size: 26rpx;
  text-align: center;
  padding: 80rpx 40rpx;
}
