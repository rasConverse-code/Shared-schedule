.page {
  min-height: 100vh;
  background: #f4f6fa;
  padding: 24rpx 28rpx 60rpx;
}

.form {
  background: #fff;
  border-radius: 24rpx;
  padding: 8rpx 28rpx;
  border: 1rpx solid #e8ecf4;
}

.field {
  padding: 28rpx 0;
  border-bottom: 1rpx solid #f0f2f7;
}

.field:last-child {
  border-bottom: none;
}

.field-row {
  display: flex;
  gap: 24rpx;
}

.field.half {
  flex: 1;
  min-width: 0;
}

.label {
  font-size: 24rpx;
  color: #8b93a7;
  margin-bottom: 12rpx;
}

.input,
.picker-value {
  font-size: 30rpx;
  color: #1c1f26;
  min-height: 48rpx;
  line-height: 48rpx;
}

.picker-value {
  padding-right: 20rpx;
}

.hint {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #a8b0c0;
}

.week-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.week-head .label {
  margin-bottom: 0;
}

.week-summary {
  font-size: 22rpx;
  color: #4f6ef7;
  font-weight: 500;
}

.week-actions {
  display: flex;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.week-action {
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: #eef1fe;
  color: #4f6ef7;
  font-size: 22rpx;
}

.week-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.week-chip {
  width: 72rpx;
  height: 64rpx;
  border-radius: 12rpx;
  background: #f4f6fa;
  color: #8b93a7;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid transparent;
}

.week-chip.on {
  background: #eef1fe;
  color: #4f6ef7;
  border-color: #4f6ef7;
  font-weight: 600;
}

.textarea {
  width: 100%;
  min-height: 120rpx;
  font-size: 28rpx;
  color: #1c1f26;
  line-height: 1.5;
}

.actions {
  margin-top: 40rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.btn-danger {
  height: 88rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ef4444;
  font-size: 30rpx;
  background: #fef2f2;
}
