<view class="page safe-bottom">
  <view class="hero">
    <view class="hero-title">和群友共享课表</view>
    <view class="hero-desc">同屏叠层，一眼看出谁被占用、谁有空</view>
    <view class="hero-actions">
      <view class="btn-primary hero-btn" bindtap="openCreate">创建群组</view>
      <view class="btn-ghost hero-btn" bindtap="openJoin">加入群组</view>
    </view>
  </view>

  <view class="section">
    <view class="section-title">我的群组</view>
    <view wx:if="{{!groups.length}}" class="empty-tip">还没有群组，先创建一个吧</view>
    <view
      class="group-card {{item.isCurrent ? 'current' : ''}}"
      wx:for="{{groups}}"
      wx:key="groupId"
      data-id="{{item.groupId}}"
      bindtap="goDetail"
    >
      <view class="group-main">
        <view class="group-name-row">
          <text class="group-name">{{item.name}}</text>
          <text wx:if="{{item.isCurrent}}" class="current-tag">当前</text>
        </view>
        <view class="group-meta">
          <text>{{item.memberCount}} 人</text>
          <text class="dot">·</text>
          <text class="code" data-code="{{item.inviteCode}}" catchtap="copyCode">邀请码 {{item.inviteCode}}</text>
        </view>
      </view>
      <view
        class="switch-btn {{item.isCurrent ? 'on' : ''}}"
        data-id="{{item.groupId}}"
        catchtap="switchGroup"
      >
        {{item.isCurrent ? '查看' : '切换'}}
      </view>
    </view>
  </view>

  <view class="share-card" wx:if="{{groups.length}}">
    <view class="share-title">转发给群友</view>
    <view class="share-desc">好友点开小程序卡片即可加入当前群组，课表实时叠层</view>
    <button class="share-btn" open-type="share">分享当前群组</button>
  </view>

  <view class="cloud-tip" wx:if="{{!cloudReady}}">
    当前为本地演示数据。在微信开发者工具开通云开发并填入 envId 后，可与真实好友同步。
  </view>

  <!-- 创建 -->
  <view class="mask" wx:if="{{showCreate}}" bindtap="closeModals"></view>
  <view class="modal {{showCreate ? 'show' : ''}}">
    <view class="modal-title">创建群组</view>
    <input
      class="modal-input"
      placeholder="群组名称，例如：宿舍 302"
      value="{{groupName}}"
      bindinput="onNameInput"
      maxlength="20"
    />
    <view class="modal-actions">
      <view class="modal-btn ghost" bindtap="closeModals">取消</view>
      <view class="modal-btn primary" bindtap="createGroup">创建</view>
    </view>
  </view>

  <!-- 加入 -->
  <view class="mask" wx:if="{{showJoin}}" bindtap="closeModals"></view>
  <view class="modal {{showJoin ? 'show' : ''}}">
    <view class="modal-title">加入群组</view>
    <input
      class="modal-input"
      placeholder="输入 6 位邀请码"
      value="{{inviteCode}}"
      bindinput="onCodeInput"
      maxlength="6"
    />
    <view class="modal-hint">演示可试 K302XX</view>
    <view class="modal-actions">
      <view class="modal-btn ghost" bindtap="closeModals">取消</view>
      <view class="modal-btn primary" bindtap="joinGroup">加入</view>
    </view>
  </view>
</view>
