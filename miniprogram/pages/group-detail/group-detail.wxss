.page {
  min-height: 100vh;
  background: #f4f6fa;
  padding: 24rpx 28rpx 60rpx;
}

.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  border: 1rpx solid #e8ecf4;
  margin-bottom: 20rpx;
}

.head-card {
  background: linear-gradient(160deg, #ffffff 0%, #f7f9ff 100%);
}

.g-name {
  font-size: 40rpx;
  font-weight: 600;
  color: #1c1f26;
}

.g-meta {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #8b93a7;
}

.code-box {
  margin-top: 28rpx;
  background: #eef1fe;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.code-label {
  font-size: 22rpx;
  color: #8b93a7;
}

.code-value {
  flex: 1;
  font-size: 34rpx;
  font-weight: 700;
  color: #4f6ef7;
  letter-spacing: 4rpx;
}

.code-copy {
  font-size: 24rpx;
  color: #4f6ef7;
}

.share {
  margin-top: 28rpx;
}

.card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1c1f26;
  margin-bottom: 20rpx;
}

.member-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f2f7;
}

.member-row:last-child {
  border-bottom: none;
}

.avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.m-name {
  flex: 1;
  font-size: 28rpx;
  color: #1c1f26;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.me {
  font-size: 20rpx;
  color: #4f6ef7;
  background: #eef1fe;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}

.m-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}

.actions {
  margin-top: 12rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.btn-danger {
  height: 88rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ef4444;
  font-size: 30rpx;
  background: #fef2f2;
}
