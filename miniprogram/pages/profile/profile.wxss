.page {
  min-height: 100vh;
  background: #f4f6fa;
  padding: 24rpx 28rpx 60rpx;
}

.profile-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  border: 1rpx solid #e8ecf4;
}

.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  color: #fff;
  font-size: 40rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.p-info {
  flex: 1;
  min-width: 0;
}

.nick-input {
  font-size: 34rpx;
  font-weight: 600;
  color: #1c1f26;
  height: 56rpx;
}

.p-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #8b93a7;
}

.list-card {
  margin-top: 20rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 8rpx 28rpx 20rpx;
  border: 1rpx solid #e8ecf4;
}

.list-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 24rpx 0 12rpx;
}

.list-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1c1f26;
}

.list-title.sm {
  display: block;
  padding: 24rpx 0 8rpx;
}

.list-count {
  font-size: 22rpx;
  color: #8b93a7;
  background: #f4f6fa;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
}

.add-link {
  margin-left: auto;
  font-size: 26rpx;
  color: #4f6ef7;
  font-weight: 500;
}

.course-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f2f7;
}

.course-row:last-child {
  border-bottom: none;
}

.c-left {
  flex: 1;
  min-width: 0;
  border-left: 8rpx solid #4f6ef7;
  padding-left: 16rpx;
}

.c-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #1c1f26;
}

.c-meta {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #8b93a7;
}

.type-tag {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
}

.type-tag.course {
  background: #ecfdf5;
  color: #10b981;
}

.type-tag.event {
  background: #fff7ed;
  color: #f59e0b;
}

.env-row {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  padding: 16rpx 0;
}

.env-label {
  width: 140rpx;
  flex-shrink: 0;
  font-size: 24rpx;
  color: #8b93a7;
}

.env-value {
  flex: 1;
  font-size: 24rpx;
  color: #1c1f26;
}

.env-value.dim {
  color: #5c6478;
}

.reset-btn {
  margin: 16rpx 0 12rpx;
  height: 72rpx;
  border-radius: 14rpx;
  background: #f4f6fa;
  color: #5c6478;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-card {
  padding: 0;
}

.nav-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx;
}

.nav-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #8b93a7;
}

.nav-arrow {
  font-size: 36rpx;
  color: #c5ccdb;
}
