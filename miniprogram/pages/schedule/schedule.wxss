.page {
  min-height: 100vh;
  background: #f4f6fa;
  padding-bottom: 40rpx;
}

/* Top bar */
.topbar {
  padding: 20rpx 28rpx 0;
  background: #f4f6fa;
  position: sticky;
  top: 0;
  z-index: 10;
}

.topbar-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.group-switch {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 12rpx 8rpx 0;
  margin-left: -4rpx;
}

.group-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #1c1f26;
  max-width: 320rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.group-caret {
  color: #8b93a7;
  font-size: 22rpx;
  transition: transform 0.2s ease;
}

.group-caret.up {
  transform: rotate(180deg);
}

.group-panel {
  position: relative;
  z-index: 20;
}

.group-panel-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(28, 31, 38, 0.28);
  z-index: 18;
}

.group-panel-body {
  position: relative;
  z-index: 19;
  margin-top: 12rpx;
  background: #fff;
  border-radius: 20rpx;
  border: 1rpx solid #e8ecf4;
  box-shadow: 0 12rpx 40rpx rgba(28, 31, 38, 0.12);
  overflow: hidden;
}

.group-panel-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 28rpx 8rpx;
}

.group-panel-title {
  font-size: 24rpx;
  color: #8b93a7;
  font-weight: 500;
}

.group-panel-close {
  font-size: 24rpx;
  color: #4f6ef7;
}

.group-panel-empty {
  padding: 32rpx 28rpx;
  font-size: 26rpx;
  color: #8b93a7;
  text-align: center;
}

.group-option {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 22rpx 28rpx;
  border-top: 1rpx solid #f0f2f7;
}

.group-option.current {
  background: #f7f9ff;
}

.group-option-main {
  flex: 1;
  min-width: 0;
}

.group-option-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #1c1f26;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.group-option-tag {
  font-size: 18rpx;
  color: #4f6ef7;
  background: #eef1fe;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  font-weight: 400;
}

.group-option-meta {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #8b93a7;
}

.group-option-check {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #4f6ef7;
  color: #fff;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.group-panel-foot {
  padding: 22rpx 28rpx;
  border-top: 1rpx solid #f0f2f7;
  font-size: 26rpx;
  color: #4f6ef7;
  text-align: center;
  background: #fafbfe;
}

.week-nav {
  text-align: right;
}

.week-nav-row {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.week-step {
  width: 48rpx;
  height: 48rpx;
  border-radius: 12rpx;
  background: #fff;
  border: 1rpx solid #e8ecf4;
  color: #4f6ef7;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.week-center {
  min-width: 140rpx;
  padding: 0 8rpx;
}

.week-num {
  display: block;
  font-size: 24rpx;
  font-weight: 600;
  color: #4f6ef7;
}

.week-range {
  display: block;
  font-size: 22rpx;
  color: #8b93a7;
  margin-top: 2rpx;
}

.member-bar {
  margin-top: 20rpx;
  width: 100%;
}

.member-list {
  display: flex;
  gap: 24rpx;
  padding: 4rpx 0 12rpx;
  white-space: nowrap;
}

.member-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 80rpx;
  flex-shrink: 0;
}

.member-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.member-avatar.add {
  background: #fff;
  color: #8b93a7;
  border: 2rpx dashed #c5ccdb;
  font-size: 36rpx;
  font-weight: 400;
}

.member-item.is-me .member-avatar {
  box-shadow: 0 0 0 4rpx #eef1fe;
}

.member-name {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #8b93a7;
  max-width: 80rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.topbar-actions {
  display: flex;
  gap: 16rpx;
  padding-bottom: 16rpx;
}

.action-chip {
  flex: 1;
  height: 64rpx;
  border-radius: 14rpx;
  background: #fff;
  color: #1c1f26;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #e8ecf4;
}

.action-chip.primary {
  background: #4f6ef7;
  color: #fff;
  border-color: #4f6ef7;
}

.empty-wrap {
  padding: 120rpx 60rpx;
  text-align: center;
}

.empty-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1c1f26;
}

.empty-desc {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #8b93a7;
  line-height: 1.6;
}

.empty-btn {
  margin-top: 40rpx;
}

/* ===== iOS 日历 ===== */
.cal-wrap {
  margin: 0 16rpx 20rpx;
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  border: 1rpx solid #e8ecf4;
}

.cal-header {
  display: flex;
  background: #fafbfe;
  border-bottom: 1rpx solid #e8ecf4;
  position: sticky;
  top: 0;
  z-index: 2;
}

.cal-corner {
  width: 80rpx;
  flex-shrink: 0;
  border-right: 1rpx solid #e8ecf4;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding-bottom: 8rpx;
}

.corner-time {
  font-size: 18rpx;
  color: #a8b0c0;
}

.cal-day-head {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 14rpx 0;
}

.cal-day-head.today {
  background: #eef1fe;
}

.cal-day-head .day-label {
  font-size: 22rpx;
  color: #8b93a7;
}

.cal-day-head.today .day-label {
  color: #4f6ef7;
  font-weight: 600;
}

.cal-day-head .day-num {
  font-size: 28rpx;
  font-weight: 600;
  color: #1c1f26;
  margin-top: 2rpx;
}

.cal-day-head.today .day-num {
  color: #4f6ef7;
}

.cal-scroll {
  max-height: calc(100vh - 420rpx);
  width: 100%;
}

.cal-body {
  display: flex;
  width: 100%;
  position: relative;
}

.cal-times {
  width: 80rpx;
  flex-shrink: 0;
  position: relative;
  border-right: 1rpx solid #e8ecf4;
  background: #fafbfe;
}

.cal-hour-label {
  position: absolute;
  right: 10rpx;
  font-size: 20rpx;
  color: #8b93a7;
  line-height: 1;
  white-space: nowrap;
}

.cal-days {
  flex: 1;
  display: flex;
  min-width: 0;
  position: relative;
}

.cal-day {
  flex: 1;
  min-width: 0;
  position: relative;
  border-right: 1rpx solid #f0f2f7;
  background: #fff;
}

.cal-day:last-child {
  border-right: none;
}

.cal-day.today {
  background: #f8faff;
}

.cal-hour-line {
  position: absolute;
  left: 0;
  right: 0;
  height: 0;
  border-top: 1rpx solid #eef1f6;
  pointer-events: none;
}

.cal-slot-band {
  position: absolute;
  left: 0;
  right: 0;
  background: rgba(28, 31, 38, 0.02);
  pointer-events: none;
}

/* 彩色事件块：上下边界 = 上下课时间 */
.cal-event {
  position: absolute;
  border-radius: 10rpx;
  border: 1rpx solid transparent;
  overflow: hidden;
  z-index: 3;
  display: flex;
  min-height: 20rpx;
  box-sizing: border-box;
}

.cal-event.narrow {
  border-radius: 6rpx;
}

.cal-event:active {
  filter: brightness(0.96);
}

.ev-bar {
  width: 6rpx;
  flex-shrink: 0;
  align-self: stretch;
}

.ev-body {
  flex: 1;
  min-width: 0;
  padding: 4rpx 6rpx 4rpx 6rpx;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
}

.ev-title {
  font-size: 20rpx;
  font-weight: 600;
  color: #1c1f26;
  line-height: 1.2;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  word-break: break-all;
}

.cal-event.narrow .ev-title {
  font-size: 16rpx;
  -webkit-line-clamp: 2;
}

.ev-time {
  font-size: 16rpx;
  color: #5c6478;
  margin-top: 2rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.cal-event.narrow .ev-time {
  font-size: 14rpx;
}

.ev-user {
  font-size: 16rpx;
  color: #8b93a7;
  margin-top: 2rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* Sheet */
.sheet-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(28, 31, 38, 0.4);
  z-index: 50;
}

.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  z-index: 51;
  transform: translateY(100%);
  transition: transform 0.28s cubic-bezier(0.2, 0.8, 0.2, 1);
  max-height: 78vh;
  display: flex;
  flex-direction: column;
  padding-bottom: env(safe-area-inset-bottom);
}

.sheet.show {
  transform: translateY(0);
}

.sheet-handle {
  width: 72rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: #e8ecf4;
  margin: 16rpx auto 8rpx;
}

.sheet-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 12rpx 32rpx 20rpx;
}

.sheet-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1c1f26;
}

.sheet-sub {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #8b93a7;
}

.sheet-close {
  font-size: 26rpx;
  color: #4f6ef7;
  padding: 8rpx 0 8rpx 24rpx;
}

.sheet-section {
  padding: 0 32rpx 8rpx;
}

.section-label {
  font-size: 22rpx;
  color: #8b93a7;
  margin-bottom: 16rpx;
  font-weight: 500;
}

.section-label.success {
  color: #22c55e;
}

.occ-card {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  background: #f8f9fc;
  border-radius: 16rpx;
  border-left: 8rpx solid #4f6ef7;
  padding: 20rpx 20rpx 20rpx 16rpx;
  margin-bottom: 16rpx;
}

.occ-left {
  display: flex;
  gap: 16rpx;
  flex: 1;
  min-width: 0;
}

.occ-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.occ-meta {
  flex: 1;
  min-width: 0;
}

.occ-user {
  font-size: 22rpx;
  color: #8b93a7;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.me-tag {
  font-size: 18rpx;
  color: #4f6ef7;
  background: #eef1fe;
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
}

.type-tag {
  font-size: 18rpx;
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
  background: #f0f2f7;
  color: #8b93a7;
}

.type-tag.event {
  background: #fff7ed;
  color: #f59e0b;
}

.type-tag.course {
  background: #ecfdf5;
  color: #10b981;
}

.occ-title {
  margin-top: 6rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #1c1f26;
}

.occ-detail {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #5c6478;
}

.occ-note {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #8b93a7;
}

.occ-edit {
  font-size: 24rpx;
  color: #4f6ef7;
  padding: 8rpx 0 8rpx 16rpx;
  flex-shrink: 0;
}

.sheet-empty {
  text-align: center;
  color: #8b93a7;
  font-size: 26rpx;
  padding: 40rpx 0 20rpx;
}

.free-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding-bottom: 8rpx;
}

.free-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
  background: #f8f9fc;
  border-radius: 999rpx;
  padding: 8rpx 18rpx 8rpx 8rpx;
}

.free-avatar {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 2rpx solid;
  font-size: 20rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.free-name {
  font-size: 24rpx;
  color: #1c1f26;
}

.query-list {
  padding: 0 32rpx 16rpx;
  overflow-y: auto;
}

.query-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f2f7;
}

.query-slot {
  width: 120rpx;
  flex-shrink: 0;
}

.query-label {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #1c1f26;
}

.query-time {
  display: block;
  font-size: 20rpx;
  color: #8b93a7;
  margin-top: 4rpx;
}

.query-free {
  flex: 1;
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  align-items: center;
}

.query-chip {
  font-size: 22rpx;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  border: 1rpx solid;
  font-weight: 500;
}

.query-none {
  font-size: 22rpx;
  color: #c5ccdb;
}

.sheet-footer {
  padding: 16rpx 32rpx 28rpx;
  border-top: 1rpx solid #f0f2f7;
  margin-top: auto;
}

.btn-primary {
  background: #4f6ef7;
  color: #fff;
  border-radius: 16rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 500;
}

.btn-ghost {
  background: #eef1fe;
  color: #4f6ef7;
  border-radius: 16rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 500;
}

.safe-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}

@media (prefers-reduced-motion: reduce) {
  .sheet,
  .group-caret {
    transition: none;
  }
}
