.page {
  min-height: 100vh;
  background: #f4f6fa;
  padding: 24rpx 28rpx 60rpx;
}

.tip {
  font-size: 22rpx;
  color: #8b93a7;
  line-height: 1.6;
  padding: 0 8rpx 20rpx;
}

.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 8rpx 28rpx 20rpx;
  border: 1rpx solid #e8ecf4;
  margin-bottom: 20rpx;
}

.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0 8rpx;
}

.card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1c1f26;
  padding: 24rpx 0 8rpx;
}

.card-head .card-title {
  padding: 0;
}

.session-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f2f7;
}

.session-row:last-of-type {
  border-bottom: 1rpx solid #f0f2f7;
}

.session-name {
  width: 120rpx;
  font-size: 26rpx;
  color: #1c1f26;
  flex-shrink: 0;
}

.stepper {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.step-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 12rpx;
  background: #eef1fe;
  color: #4f6ef7;
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.step-val {
  min-width: 48rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #1c1f26;
}

.session-start {
  margin-left: auto;
  font-size: 24rpx;
  color: #4f6ef7;
  background: #f4f6fa;
  padding: 10rpx 16rpx;
  border-radius: 10rpx;
}

.break-input {
  width: 100rpx;
  height: 56rpx;
  background: #f4f6fa;
  border-radius: 10rpx;
  text-align: center;
  font-size: 28rpx;
  color: #1c1f26;
}

.unit {
  font-size: 24rpx;
  color: #8b93a7;
}

.regen-btn {
  margin-top: 20rpx;
  height: 72rpx;
  border-radius: 14rpx;
  background: #eef1fe;
  color: #4f6ef7;
  font-size: 26rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
}

.period-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f2f7;
}

.period-item:last-child {
  border-bottom: none;
}

.period-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.period-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #1c1f26;
}

.period-session {
  font-size: 20rpx;
  color: #4f6ef7;
  background: #eef1fe;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}

.period-fields {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx 20rpx;
  align-items: center;
}

.field-inline {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.field-label {
  font-size: 22rpx;
  color: #8b93a7;
  width: 56rpx;
}

.field-input {
  min-width: 160rpx;
  height: 56rpx;
  background: #f4f6fa;
  border-radius: 10rpx;
  padding: 0 16rpx;
  font-size: 26rpx;
  color: #1c1f26;
  display: flex;
  align-items: center;
}

.period-end {
  width: 100%;
  font-size: 22rpx;
  color: #5c6478;
  padding-left: 66rpx;
}

.hint-line {
  font-size: 22rpx;
  color: #a8b0c0;
  padding: 12rpx 0 8rpx;
  line-height: 1.5;
}

.row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #f0f2f7;
}

.row:last-child {
  border-bottom: none;
}

.row.muted .label,
.row.muted .value {
  color: #8b93a7;
}

.label {
  flex: 1;
  font-size: 26rpx;
  color: #1c1f26;
}

.value {
  font-size: 28rpx;
  color: #1c1f26;
}

.value.link {
  color: #4f6ef7;
}

.value-input {
  width: 100rpx;
  text-align: right;
  font-size: 28rpx;
  color: #1c1f26;
  height: 48rpx;
}

.actions {
  margin-top: 12rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.empty-tip {
  color: #8b93a7;
  font-size: 26rpx;
  text-align: center;
  padding: 40rpx 0;
}

.btn-primary {
  background: #4f6ef7;
  color: #fff;
  border-radius: 16rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 500;
}

.btn-ghost {
  background: #eef1fe;
  color: #4f6ef7;
  border-radius: 16rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 500;
}
